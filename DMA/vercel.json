{
  "env": {
    "VITE_API_URL": "https://dove-church-backend.vercel.app/api",
    "VITE_BACKEND_URL": "https://dove-church-backend.vercel.app"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://dove-church-backend.vercel.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://dove-church-backend.vercel.app/uploads/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
